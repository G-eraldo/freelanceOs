{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "freelanceOs",
  "version": "1.0.2",
  "identifier": "fr.lafabriqueducode.app",
  "build": {
    "frontendDist": "https://freelance.lafabriqueducode.fr",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate"
  },
  "app": {
    "windows": [
      {
        "title": "La Fabrique du Code",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QzBENUExNzFFMDNERDcKUldUWFBlQnhvZFhBaVJ4QVVkQUdsc0lFOEZSdU8xY3dWaXF6L2Q2N25aN011R0Z3MzdPOEh1VmoK",
      "endpoints": [
        "https://github.com/G-eraldo/freelanceOs/releases/latest/download/latest.json"
      ]
    }
  }
}
